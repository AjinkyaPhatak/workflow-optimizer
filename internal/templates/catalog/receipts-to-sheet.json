{
  "id": "receipts-to-sheet",
  "name": "Log receipts from email in a sheet",
  "description": "Finds your newest receipt email, pulls out the shop, date and amount, and adds a row to a Google Sheet.",
  "category": "Email",
  "order": 4,
  "setup": [
    "Make a Google Sheet whose first row has the columns Date, Shop, Amount and Subject, and paste its link on the Add a row card."
  ],
  "definition": {
    "version": 1,
    "settings": {},
    "nodes": [
      {
        "id": "start",
        "type": "input",
        "name": "Start",
        "position": {
          "x": 0,
          "y": 120
        },
        "config": {}
      },
      {
        "id": "read",
        "type": "gmail.read",
        "name": "Read the newest receipt",
        "position": {
          "x": 380,
          "y": 120
        },
        "config": {
          "find": "subject:(receipt OR invoice OR order) newer_than:7d"
        }
      },
      {
        "id": "extract",
        "type": "llm",
        "name": "Find the details",
        "position": {
          "x": 760,
          "y": 120
        },
        "config": {
          "provider": "gemini",
          "model": "gemini-3.5-flash-lite",
          "temperature": 0,
          "prompt": "From this email, find the shop or company, the date and the total amount. Reply with JSON only, like {\"shop\": \"...\", \"date\": \"YYYY-MM-DD\", \"amount\": \"...\"}\n\nFrom: {{sender}}\nSubject: {{subject}}\n\n{{body}}"
        }
      },
      {
        "id": "parse",
        "type": "structured_output",
        "name": "Check the details",
        "position": {
          "x": 1140,
          "y": 120
        },
        "config": {
          "schema": {
            "shop": "string",
            "date": "string",
            "amount": "string"
          }
        }
      },
      {
        "id": "log",
        "type": "google_sheets.append_row",
        "name": "Add a row",
        "position": {
          "x": 1520,
          "y": 120
        },
        "config": {
          "values": {
            "Date": "{{receipt.date}}",
            "Shop": "{{receipt.shop}}",
            "Amount": "{{receipt.amount}}",
            "Subject": "{{subject}}"
          }
        }
      },
      {
        "id": "out",
        "type": "output",
        "name": "Row added",
        "position": {
          "x": 1900,
          "y": 120
        },
        "config": {}
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "start",
        "source_port": "data",
        "target": "read",
        "target_port": "message_id"
      },
      {
        "id": "e2",
        "source": "read",
        "source_port": "sender",
        "target": "extract",
        "target_port": "var:sender"
      },
      {
        "id": "e3",
        "source": "read",
        "source_port": "subject",
        "target": "extract",
        "target_port": "var:subject"
      },
      {
        "id": "e4",
        "source": "read",
        "source_port": "body",
        "target": "extract",
        "target_port": "var:body"
      },
      {
        "id": "e5",
        "source": "extract",
        "source_port": "response",
        "target": "parse",
        "target_port": "input"
      },
      {
        "id": "e6",
        "source": "parse",
        "source_port": "output",
        "target": "log",
        "target_port": "var:receipt"
      },
      {
        "id": "e7",
        "source": "read",
        "source_port": "subject",
        "target": "log",
        "target_port": "var:subject"
      },
      {
        "id": "e8",
        "source": "log",
        "source_port": "row_number",
        "target": "out",
        "target_port": "value"
      }
    ]
  }
}
