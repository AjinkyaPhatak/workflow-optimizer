{
  "id": "reply-drafter",
  "name": "Draft a reply to my latest email",
  "description": "Reads your newest unread email and saves a suggested reply in Gmail Drafts. Nothing is sent.",
  "category": "Email",
  "order": 1,
  "setup": [
    "Change \"Find\" on the first card to pick which email to answer, e.g. from:boss@example.com."
  ],
  "definition": {
    "version": 1,
    "settings": {},
    "nodes": [
      {
        "id": "start",
        "type": "input",
        "name": "Start",
        "position": {
          "x": 0,
          "y": 120
        },
        "config": {}
      },
      {
        "id": "read",
        "type": "gmail.read",
        "name": "Read the newest email",
        "position": {
          "x": 380,
          "y": 120
        },
        "config": {
          "find": "is:unread in:inbox"
        }
      },
      {
        "id": "write",
        "type": "llm",
        "name": "Write a reply",
        "position": {
          "x": 760,
          "y": 120
        },
        "config": {
          "provider": "gemini",
          "model": "gemini-2.5-flash",
          "temperature": 0.5,
          "prompt": "Write a friendly, short reply to this email. Reply with the text of the reply only, without a subject line.\n\nFrom: {{sender}}\nSubject: {{subject}}\n\n{{body}}"
        }
      },
      {
        "id": "draft",
        "type": "gmail.create_draft",
        "name": "Save the draft",
        "position": {
          "x": 1140,
          "y": 120
        },
        "config": {
          "to": "{{sender}}",
          "subject": "Re: {{subject}}",
          "body": "{{reply}}"
        }
      },
      {
        "id": "done",
        "type": "text",
        "name": "Result",
        "position": {
          "x": 1520,
          "y": 120
        },
        "config": {
          "text": "Reply saved as a {{status}} in Gmail for {{sender}}:\n\n{{reply}}"
        }
      },
      {
        "id": "out",
        "type": "output",
        "name": "Result",
        "position": {
          "x": 1900,
          "y": 120
        },
        "config": {}
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "start",
        "source_port": "data",
        "target": "read",
        "target_port": "message_id"
      },
      {
        "id": "e2",
        "source": "read",
        "source_port": "sender",
        "target": "write",
        "target_port": "var:sender"
      },
      {
        "id": "e3",
        "source": "read",
        "source_port": "subject",
        "target": "write",
        "target_port": "var:subject"
      },
      {
        "id": "e4",
        "source": "read",
        "source_port": "body",
        "target": "write",
        "target_port": "var:body"
      },
      {
        "id": "e5",
        "source": "read",
        "source_port": "sender",
        "target": "draft",
        "target_port": "var:sender"
      },
      {
        "id": "e6",
        "source": "read",
        "source_port": "subject",
        "target": "draft",
        "target_port": "var:subject"
      },
      {
        "id": "e7",
        "source": "write",
        "source_port": "response",
        "target": "draft",
        "target_port": "var:reply"
      },
      {
        "id": "e8",
        "source": "draft",
        "source_port": "status",
        "target": "done",
        "target_port": "var:status"
      },
      {
        "id": "e9",
        "source": "read",
        "source_port": "sender",
        "target": "done",
        "target_port": "var:sender"
      },
      {
        "id": "e10",
        "source": "write",
        "source_port": "response",
        "target": "done",
        "target_port": "var:reply"
      },
      {
        "id": "e11",
        "source": "done",
        "source_port": "output",
        "target": "out",
        "target_port": "value"
      }
    ]
  }
}
