# Local development infrastructure
DATABASE_URL=postgres://workflow:workflow@localhost:5432/workflow_optimizer?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Worker (cmd/worker). Defaults shown; all optional except the URLs above.
REDIS_QUEUE_NAME=workflow:executions
WORKER_COUNT=1
WORKER_SHUTDOWN_TIMEOUT=30s

# Retry, timeout and recovery (Phase 10). Defaults shown; all optional.
DEFAULT_MAX_ATTEMPTS=3
DEFAULT_INITIAL_RETRY_DELAY=1s
DEFAULT_MAX_RETRY_DELAY=5m
DEFAULT_BACKOFF_MULTIPLIER=2
DEFAULT_EXECUTION_TIMEOUT=1h
DEFAULT_NODE_TIMEOUT=5m
DEFAULT_NODE_MAX_ATTEMPTS=2
REAPER_INTERVAL=15s
WORKER_LEASE_DURATION=30s
WORKER_HEARTBEAT_INTERVAL=10s
SCHEDULER_INTERVAL=1s
REDIS_DEAD_LETTER_QUEUE=workflow:dead-letter

# Credentials (Phase 11). Provider API keys are stored as encrypted workspace
# credentials, never in the environment. The master key: 32 random bytes,
# base64 (e.g. `openssl rand -base64 32`). Never commit a real key.
CREDENTIAL_ENCRYPTION_KEY=
# Optional OpenAI endpoint override (default https://api.openai.com/v1).
OPENAI_BASE_URL=

# Google OAuth for Gmail (Phase C3). Optional: set all three or none. When
# unset, Google is not offered on the Connected accounts page. The client is a
# Google Cloud "Web application" OAuth client; the redirect URI must be
# registered there exactly and must be <frontend origin>/api/v1/oauth/callback/google
# (the browser reaches the API through the frontend's /api/v1 proxy).
# Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# REST API (cmd/api, Phase 12). AUTH_TOKEN_SECRET signs bearer tokens: at least
# 32 random bytes (e.g. `openssl rand -base64 48`). Never commit a real one.
API_ADDR=:8080
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL=24h

# Observability (Phase 14). MODEL_PRICING enables ESTIMATED LLM cost in the
# execution debugger: USD per million tokens, e.g.
# {"gpt-5":{"input_per_million":1.25,"output_per_million":10}}. Empty = no estimates.
MODEL_PRICING=
# Show (redacted) node inputs/outputs in the execution debugger (default true).
OBSERVABILITY_EXPOSE_NODE_DATA=true
