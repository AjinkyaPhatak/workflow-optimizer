# Local development infrastructure
POSTGRES_PORT=55432
REDIS_PORT=56379
DATABASE_URL=postgres://workflow:workflow@127.0.0.1:55432/workflow_optimizer?sslmode=disable
REDIS_URL=redis://127.0.0.1:56379/0
BACKEND_URL=http://127.0.0.1:18080

# Worker (cmd/worker). Defaults shown; all optional except the URLs above.
REDIS_QUEUE_NAME=workflow:executions
WORKER_COUNT=1
WORKER_SHUTDOWN_TIMEOUT=30s

# Retry, timeout and recovery (Phase 10). Defaults shown; all optional.
DEFAULT_MAX_ATTEMPTS=3
DEFAULT_INITIAL_RETRY_DELAY=1s
DEFAULT_MAX_RETRY_DELAY=5m
DEFAULT_BACKOFF_MULTIPLIER=2
DEFAULT_EXECUTION_TIMEOUT=1h
DEFAULT_NODE_TIMEOUT=5m
DEFAULT_NODE_MAX_ATTEMPTS=2
REAPER_INTERVAL=15s
WORKER_LEASE_DURATION=30s
WORKER_HEARTBEAT_INTERVAL=10s
SCHEDULER_INTERVAL=1s
REDIS_DEAD_LETTER_QUEUE=workflow:dead-letter

# Credentials (Phase 11). Provider API keys are stored as encrypted workspace
# credentials, never in the environment. The master key: 32 random bytes,
# base64 (e.g. `openssl rand -base64 32`). Never commit a real key.
CREDENTIAL_ENCRYPTION_KEY=
# Optional OpenAI endpoint override (default https://api.openai.com/v1).
OPENAI_BASE_URL=
# Optional overrides of the Gemini and Groq endpoints (normally empty).
GEMINI_BASE_URL=
GROQ_BASE_URL=

# Google OAuth for Gmail, Google Sheets and Google Calendar (Phases C3, C4). Optional: set all three or none. When
# unset, the Connected accounts page shows Google setup instructions. The client is a
# Google Cloud "Web application" OAuth client; the redirect URI must be
# registered there exactly and must be <frontend origin>/api/v1/oauth/callback/google
# (the browser reaches the API through the frontend's /api/v1 proxy).
# Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Notion OAuth (Phase C5). Optional: set all three or none. A Notion "public"
# integration (notion.so/profile/integrations); its redirect URI must be
# <frontend origin>/api/v1/oauth/callback/notion. Never commit real values.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=

# Airtable OAuth (Phase J). Optional: set all three or none. An Airtable OAuth
# integration (airtable.com/create/oauth) with a client secret and the scopes
# data.records:read, data.records:write, schema.bases:read and user.email:read;
# its redirect URI must be <frontend origin>/api/v1/oauth/callback/airtable.
# Never commit real values.
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
AIRTABLE_OAUTH_REDIRECT_URI=

# Discord (Phase C6). Optional: set all four or none. One Discord application
# (discord.com/developers/applications) whose bot users add to their servers.
# The redirect URI must be <frontend origin>/api/v1/oauth/callback/discord.
# DISCORD_BOT_TOKEN is the bot's token (Bot page). Never commit real values.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=
DISCORD_BOT_TOKEN=

# REST API (cmd/api, Phase 12). AUTH_TOKEN_SECRET signs bearer tokens: at least
# 32 random bytes (e.g. `openssl rand -base64 48`). Never commit a real one.
API_ADDR=127.0.0.1:18080
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL=24h

# HTTP Request node (Phase C7). Requests to localhost, private and link-local
# addresses (and cloud metadata) are blocked unless this is true, e.g. to call
# a local API during development.
HTTP_ALLOW_PRIVATE_NETWORKS=false

# Observability (Phase 14). MODEL_PRICING enables ESTIMATED LLM cost in the
# execution debugger: USD per million tokens, e.g.
# {"gpt-5":{"input_per_million":1.25,"output_per_million":10}}. Empty = no estimates.
MODEL_PRICING=
# Show (redacted) node inputs/outputs in the execution debugger (default true).
OBSERVABILITY_EXPOSE_NODE_DATA=true

# Voice and durable automation. Platform keys stay on the server; OpenAI can
# also be selected from encrypted workspace credentials on the home page.
TEMPORAL_ADDRESS=127.0.0.1:57233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=workflow-optimizer-v2
OPENAI_API_KEY=
PLANNER_MODEL=gpt-6-luna
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
EMBEDDING_URL=http://127.0.0.1:58081
COMPUTE_SERVICE_TOKEN=
WHATSAPP_CONNECTOR_URL=http://127.0.0.1:58082
CONNECTOR_ADDR=127.0.0.1:58082
CONNECTOR_SERVICE_TOKEN=
AUTOMATION_WEBHOOK_SECRET=
ANALYSIS_IMAGE=workflow-optimizer-analysis:local
